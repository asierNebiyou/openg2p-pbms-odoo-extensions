<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_dashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="G2P Dashboard Settings" name="g2p_dashboard_settings" logo="/g2p_pbms/static/description/icon.png">
                    <block title="BG Task Database Configuration">
                        <setting string="Host">
                            <field name="bg_task_db_host" />
                        </setting>
                        <setting string="Port">
                            <field name="bg_task_db_port" />
                        </setting>
                        <setting string="User">
                            <field name="bg_task_db_user" />
                        </setting>
                        <setting string="Password">
                            <field name="bg_task_db_password" password="True" />
                        </setting>
                        <setting string="Database Name">
                            <field name="bg_task_db_name" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
